{
    "manifest_version": 3,
    "name": "Jalali Date Convertor تبدیل تاریخ جلالی",
    "version": "1.0.5",
    "description": "Convert Jalali(Shamsi) date to Gregorian date and vice versa \n. جهت تبدیل تاریخ شمسی به میلادی و برعکس",
    "author": "Roohallah Alizadeh",
    "browser_specific_settings": {
        "gecko": {
            "id": "JalaliDateConvertor.roohial57@gmail.com",
            "strict_min_version": "102.0"
        },
        "chrome": {}
    },
    "background": {
        "scripts": [
            "selected-text/add-context-menu-gecko.js"
        ],
        "service_worker": "background-chrome.js"
    },
    "permissions": [
        "contextMenus",
        "activeTab",
        "scripting",
        "storage"
    ],
    "icons": {
        "128": "img/icon128.png"
    },
    "action": {
        "default_popup": "popup/index.html",
        "default_title": "Jalali Date Convertor"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "js/jalaali-core.js"
            ],
            "matches": [
                "http://*/*",
                "https://*/*"
            ]
        }
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "js/jalaali-core.js",
                "selected-text/script.js",
                "js/jalaali.min.js"
            ],
            "css": [
                "selected-text/styles.css"
            ],
            "run_at": "document_end"
        }
    ]
}